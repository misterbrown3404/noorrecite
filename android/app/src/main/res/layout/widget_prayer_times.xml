<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_background"
        android:padding="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="NEXT PRAYER"
        android:textSize="11sp"
        android:textColor="#F4D49B"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:letterSpacing="0.12"
        android:textStyle="bold"/>
        <TextView
        android:id="@+id/tv_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="12sp"
        android:textColor="#F4D49B"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:background="@drawable/widget_chip_background"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp">
        <TextView
        android:id="@+id/tv_next_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"/>
        <TextView
        android:id="@+id/tv_next_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="20sp"
        android:textColor="#F4D49B"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_chip_background">
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
            <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:padding="10dp">
                <TextView
        android:id="@+id/tv_fajr_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fajr"
        android:textSize="12sp"
        android:textColor="#C4D9D5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"/>
                <TextView
        android:id="@+id/tv_fajr_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:padding="10dp">
                <TextView
        android:id="@+id/tv_dhuhr_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dhuhr"
        android:textSize="12sp"
        android:textColor="#C4D9D5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"/>
                <TextView
        android:id="@+id/tv_dhuhr_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:padding="10dp">
                <TextView
        android:id="@+id/tv_asr_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Asr"
        android:textSize="12sp"
        android:textColor="#C4D9D5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"/>
                <TextView
        android:id="@+id/tv_asr_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
            <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:padding="10dp">
                <TextView
        android:id="@+id/tv_maghrib_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Maghrib"
        android:textSize="12sp"
        android:textColor="#C4D9D5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"/>
                <TextView
        android:id="@+id/tv_maghrib_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:padding="10dp">
                <TextView
        android:id="@+id/tv_isha_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Isha"
        android:textSize="12sp"
        android:textColor="#C4D9D5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"/>
                <TextView
        android:id="@+id/tv_isha_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

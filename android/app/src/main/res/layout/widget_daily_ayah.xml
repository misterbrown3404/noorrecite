<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_background"
        android:padding="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="DAILY AYAH"
        android:textSize="11sp"
        android:textColor="#F4D49B"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:letterSpacing="0.14"
        android:textStyle="bold"/>
        <TextView
        android:id="@+id/tv_bismillah"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="﷽"
        android:textSize="22sp"
        android:textColor="#F4D49B"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_ayah_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
        android:textSize="26sp"
        android:textColor="#FFFFFF"
        android:includeFontPadding="false"
        android:gravity="end"
        android:textDirection="rtl"
        android:fontFamily="serif"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="5dp"
        android:maxLines="3"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/tv_translation"
        android:layout_width="match_parent"
        android:text="In the name of Allah, the Entirely Merciful, the Especially Merciful."
        android:textSize="15sp"
        android:textColor="#C4D9D5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <TextView
        android:id="@+id/tv_ref"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Al-Fatiha 1:1"
        android:textSize="12sp"
        android:textColor="#F4D49B"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QariVerse"
        android:textSize="11sp"
        android:textColor="#C4D9D5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>

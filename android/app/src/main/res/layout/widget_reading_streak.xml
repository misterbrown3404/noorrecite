<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_gold_background"
        android:padding="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
        android:id="@+id/tv_streak_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="READING"
        android:textSize="10sp"
        android:textColor="#F4D49B"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:letterSpacing="0.1"
        android:textStyle="bold"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_streak_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="42sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="day streak"
        android:textSize="14sp"
        android:textColor="#F3DAB5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginTop="2dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_chip_background"
        android:padding="10dp"
        android:layout_marginTop="12dp">
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
            <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textSize="12sp"
        android:textColor="#F3DAB5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_weight="1"/>
            <TextView
        android:id="@+id/tv_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
            <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Goal"
        android:textSize="12sp"
        android:textColor="#F3DAB5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_weight="1"/>
            <TextView
        android:id="@+id/tv_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_last_surah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keep your connection"
        android:textSize="11sp"
        android:textColor="#F3DAB5"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:ellipsize="end"/>
</LinearLayout>
